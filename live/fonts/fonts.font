#######################################################################
#######################################################################
#######################################################################

# Each font should specify what it is used for.
# Name fonts after intented usage, not after source file names.

font = {
	name = "Debug"

	fontstyle = {
		style = regular
		fontfiles = "OpenSans-SemiBold"
	}
}

## Font used in-game
font = {
	name = "StandardGameFont"

	fontstyle = {
		style = regular
		fontfiles = "Exo2-Regular"
	}

	fontstyle = {
		style = bold
		fontfiles = "Exo2-Bold"
	}

	fontstyle = {
		style = italic
		fontfiles = "Exo2-Italic"
	}

	fontstyle = {
		style = bold|italic
		fontfiles = "Exo2-BoldItalic"
	}

	underlineformats = {
		default = {
			thickness = 1
			offset = 0.12
		}
	}
}

# Title font
font = {
	name = "TitleFont"

	fontstyle = {
		style = bold
		fontfiles = "Sansation-Bold"
	}
	
	fontstyle = {
		style = bold|italic
		fontfiles = "Sansation-BoldItalic"
	}
}

# For map names
font = {
	name = "MapFont"

	fontstyle = {
		style = regular
		fontfiles = "Goldman-Regular"
	}
}
