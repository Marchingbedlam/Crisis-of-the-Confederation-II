hbox = {
	name = "bill_votes"
	datacontext = "[ActivityWindow.GetActivity]"
	spacing = 25

	vbox = {
		text_single = {
			text = "bill_supporter_count"
			align = nobaseline
			max_width = 200
		}
		text_single = {
			text = "bill_opponent_count"
			align = nobaseline
			max_width = 200
		}
	}

	progressbar_standard = {
		layoutpolicy_horizontal = expanding
		size = { 200 30 }
		value = "[Multiply_CFixedPoint( Activity.MakeScope().ScriptValue( 'total_bill_supporters' ), '(CFixedPoint)1' )]"
		max = "[Multiply_CFixedPoint( Activity.MakeScope().ScriptValue( 'total_legislators_present' ), '(CFixedPoint)1' )]"
		min = 0

		using = Progressbar_Changed_Animation

		datacontext = "[GuiScope.SetRoot( Activity.MakeScope ).GetScriptValueBreakdown( 'total_bill_supporters' )]"
		tooltip_visible = "[ValueBreakdown.HasTooltip]"

		tooltipwidget = {
			widget_value_breakdown_tooltip = {
				datacontext = "[GuiScope.SetRoot( Activity.MakeScope ).GetScriptValueBreakdown( 'total_bill_supporters' )]"
			}
		}

		marker = {
			name = "current_value"
			widget = {
				icon = {
					size = { 25 25 }
					position = { -20 2 }
					texture = "gfx/interface/progressbars/progressbar_center_glow.dds"
					color = { 0.80 0.90 1 0.9 }
				}
			}
		}
	}
}
