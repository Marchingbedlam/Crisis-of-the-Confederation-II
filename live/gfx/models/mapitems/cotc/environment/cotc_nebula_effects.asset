# Sheet lightning inside the nebulae. One entity per region; the flash tint is
# baked into each particle graph, derived from the painted fog colour.

entity = {
	name = "cotc_nebula_lightning_orion"

	locator = { name = "part1" position = { 0 0 0 } }

	default_state = "idle"
	state = { name = "idle" state_time = 10
		event = { time = 0 node = "part1" particle = "environment/cotc_nebula_lightning_orion" trigger_once = yes keep_particle = yes }
	}

	# Large sprite - without this the flash pops at the screen edge
	cull_radius = 80
}

